{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/animation-knowledge-graph/schemas/pattern.schema.json",
  "title": "Pattern",
  "description": "Hypothesis or validated design rule with evidence and tests.",
  "type": "object",
  "required": [
    "record_type",
    "record_id",
    "category",
    "statement",
    "scope",
    "exclusions",
    "parameters",
    "status",
    "evidence_observation_ids",
    "independent_source_count",
    "contradiction_ids",
    "confidence",
    "confidence_rationale",
    "generator_ids",
    "experiment_ids",
    "version",
    "last_reviewed_at",
    "synthetic_example"
  ],
  "additionalProperties": false,
  "properties": {
    "record_type": {
      "const": "pattern"
    },
    "record_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "hypothesis",
        "single_example",
        "supported",
        "validated",
        "contradicted",
        "deprecated"
      ]
    },
    "evidence_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_source_count": {
      "type": "integer",
      "minimum": 0
    },
    "contradiction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_rationale": {
      "type": "string"
    },
    "generator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    },
    "last_reviewed_at": {
      "type": "string"
    },
    "synthetic_example": {
      "type": "boolean"
    }
  }
}
